# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/inculva"

# ── API (apps/api) ────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── App URLs ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000        # production: https://app.inculva.com
NEXT_PUBLIC_API_URL=http://localhost:3001        # production: https://api.inculva.com
NEXT_PUBLIC_LANDING_URL=https://inculva.com      # same in dev and prod

# ── CDN (Cloudflare R2) — widget.js, fonts, icons, i18n, logos ───────────────
NEXT_PUBLIC_CDN_URL=https://cdn.inculva.com
# In development, widget.js is served by the manage app (localhost:3000).
# Run `pnpm --filter @inculva/widget dev` to keep widget.js rebuilt on change.
# In production set to: https://cdn.inculva.com/widget.js
NEXT_PUBLIC_WIDGET_URL=http://localhost:3000/widget.js

# ── Widget build-time env (packages/widget — injected by Vite define) ─────────
VITE_CDN_URL=https://cdn.inculva.com    # fonts/icons/i18n always from CDN
VITE_API_URL=http://localhost:3001      # production: https://api.inculva.com

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Email — Resend (resend.com) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Inculva <hi@inculva.com>

# ── Cloudflare R2 (CDN for widget.js) ─────────────────────────────────────────
# Set as GitHub Actions secrets — NOT needed at runtime
# R2_ACCOUNT_ID=abc123...              # Cloudflare account ID
# R2_ACCESS_KEY_ID=...                 # R2 API token access key ID
# R2_SECRET_ACCESS_KEY=...             # R2 API token secret access key
# R2_BUCKET_NAME=inculva-widget        # R2 bucket name

# ── Railway (railway.app) — API deployment ────────────────────────────────────
# Set DATABASE_URL to the Railway PostgreSQL connection string in Railway dashboard.
# Set CORS_ORIGIN to your production web app URL (e.g. https://app.inculva.com).
# The API also sends usage alert emails — set these in the Railway API service too:
#   RESEND_API_KEY, EMAIL_FROM, NEXT_PUBLIC_APP_URL

# ── Billing — LemonSqueezy (lemonsqueezy.com) ─────────────────────────────────
# Server-side API key — from LemonSqueezy dashboard → API Keys
LEMONSQUEEZY_API_KEY=eyJ0eXAiOiJKV1Qi_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Store ID — numeric, from LemonSqueezy dashboard → Settings → Stores
LEMONSQUEEZY_STORE_ID=12345
# Webhook signing secret — from LemonSqueezy dashboard → Webhooks
LEMONSQUEEZY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pro plan variant ID from LemonSqueezy product variants
LS_PRO_VARIANT_ID=123456
# Business plan variant ID from LemonSqueezy product variants
LS_BUSINESS_VARIANT_ID=789012
