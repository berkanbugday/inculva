{
  "name": "@inculva/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx/esm --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "install-browsers": "pnpm --filter @inculva/scanner run install-browsers"
  },
  "dependencies": {
    "@fastify/cors": "10.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.2.2",
    "@inculva/db": "workspace:*",
    "@inculva/email": "workspace:*",
    "@inculva/scanner": "workspace:*",
    "@inculva/types": "workspace:*",
    "bullmq": "5.34.8",
    "fastify": "5.2.1",
    "fastify-plugin": "5.1.0",
    "ioredis": "5.4.2"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "pino-pretty": "13.1.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
