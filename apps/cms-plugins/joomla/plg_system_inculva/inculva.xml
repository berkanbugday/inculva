<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="system" method="upgrade">
    <name>PLG_SYSTEM_INCULVA</name>
    <creationDate>2024</creationDate>
    <author>inculva</author>
    <authorUrl>https://inculva.com</authorUrl>
    <copyright>inculva</copyright>
    <license>GPL v2</license>
    <version>1.0.0</version>
    <description>PLG_SYSTEM_INCULVA_XML_DESCRIPTION</description>
    <files>
        <filename plugin="inculva">inculva.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_system_inculva.ini</language>
        <language tag="tr-TR">language/tr-TR/tr-TR.plg_system_inculva.ini</language>
    </languages>
    <config>
        <fields name="params">
            <fieldset name="basic">

                <field name="site_id" type="text"
                       label="PLG_SYSTEM_INCULVA_SITE_ID"
                       description="PLG_SYSTEM_INCULVA_SITE_ID_DESC"
                       default="" />

                <field name="api_url" type="url"
                       label="PLG_SYSTEM_INCULVA_API_URL"
                       description="PLG_SYSTEM_INCULVA_API_URL_DESC"
                       default="https://api.inculva.com" />

            </fieldset>
        </fields>
    </config>
</extension>
