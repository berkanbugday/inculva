---
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  slug: string;
  publishedAt: string;
  image?: string;
  imageAlt?: string;
}

const { title, description, slug, publishedAt, image, imageAlt } = Astro.props;

const formattedDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group">
  <a href={`/blog/${slug}`} class="block bg-white rounded-2xl border border-gray-100 shadow-soft overflow-hidden hover-lift">
    <!-- Image -->
    <div class="aspect-video bg-gradient-to-br from-primary-100 to-accent-50 relative overflow-hidden">
      {image ? (
        <Image
          src={image}
          alt={imageAlt || title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
          width={600}
          height={340}
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center">
          <svg class="w-12 h-12 text-primary-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
          </svg>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="p-6">
      <time class="text-sm text-gray-500 font-medium" datetime={publishedAt}>
        {formattedDate}
      </time>
      <h3 class="mt-2 text-lg font-semibold text-gray-900 group-hover:text-primary-600 transition-colors line-clamp-2">
        {title}
      </h3>
      <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">
        {description}
      </p>
      <span class="mt-4 inline-flex items-center text-sm font-semibold text-primary-600 group-hover:gap-2 gap-1 transition-all">
        Read more
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </a>
</article>
