---
import Container from './Container.astro';
import { t, getLangFromUrl, getLocalizedPath, getAlternateLanguage, getPathWithoutLang, languages, type Lang } from '@/i18n';

interface Props {
  lang?: Lang;
  alternateHref?: string;
}

const lang = Astro.props.lang ?? getLangFromUrl(Astro.url);
const i = t(lang);
const altLang = getAlternateLanguage(lang);
const currentPathWithoutLang = getPathWithoutLang(Astro.url.pathname);

const navLinks = [
  { label: i.nav.home, href: getLocalizedPath('/', lang) },
  { label: i.nav.features, href: getLocalizedPath('/features', lang) },
  {
    label: i.nav.resources,
    href: getLocalizedPath('/kb', lang),
    children: [
      { label: i.nav.kb, href: getLocalizedPath('/kb', lang) },
      { label: i.nav.blog, href: getLocalizedPath('/blog', lang) },
    ],
  },
  { label: i.nav.pricing, href: getLocalizedPath('/pricing', lang) },
  { label: i.nav.about, href: getLocalizedPath('/about', lang) },
  { label: i.nav.contact, href: getLocalizedPath('/contact', lang) },
];

const currentPath = Astro.url.pathname;
const CDN_URL = import.meta.env.PUBLIC_CDN_URL || 'https://cdn.inculva.com';
const APP_URL = import.meta.env.PUBLIC_APP_URL || 'http://localhost:3000';
const switchHref = Astro.props.alternateHref || getLocalizedPath(currentPathWithoutLang, altLang);
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-lg border-b border-gray-100">
  <Container>
    <nav class="flex items-center justify-between h-16 md:h-18" aria-label="Main navigation">
      <!-- Logo -->
      <a href={getLocalizedPath('/', lang)} class="flex items-center gap-2 group" aria-label="inculva home">
        <img src={`${CDN_URL}/logos/logo-dark.png`} alt="inculva Logo" class="w-40 object-contain" />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map((link) => (
          link.children ? (
            <div class="relative group">
              <button
                type="button"
                class:list={[
                  'px-4 py-2 text-sm font-medium rounded-lg transition-colors inline-flex items-center gap-1',
                  link.children.some(c => currentPath === c.href || currentPath.startsWith(c.href + '/'))
                    ? 'text-primary-600 bg-primary-50'
                    : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
                ]}
              >
                {link.label}
                <svg class="w-3.5 h-3.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div class="absolute top-full left-0 pt-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
                <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-1 min-w-[180px]">
                  {link.children.map((child) => (
                    <a
                      href={child.href}
                      class:list={[
                        'block px-4 py-2.5 text-sm font-medium transition-colors',
                        currentPath === child.href || currentPath.startsWith(child.href + '/')
                          ? 'text-primary-600 bg-primary-50'
                          : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
                      ]}
                    >
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              class:list={[
                'px-4 py-2 text-sm font-medium rounded-lg transition-colors',
                currentPath === link.href || (link.href !== getLocalizedPath('/', lang) && currentPath.startsWith(link.href + '/'))
                  ? 'text-primary-600 bg-primary-50'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
              ]}
            >
              {link.label}
            </a>
          )
        ))}
      </div>

      <!-- CTA + Language Switch + Mobile Toggle -->
      <div class="flex items-center gap-3">
        <a href={`${APP_URL}/login`} class="hidden md:inline-flex items-center px-5 py-2.5 text-sm font-semibold text-primary-600 bg-transparent border border-primary-600 rounded-full hover:bg-primary-50 transition-colors">
          {i.nav.signIn}
        </a>

        <a href="#" data-cal-link="berkan-bugday-rdudv5/30min" class="hidden md:inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-primary-600 rounded-full hover:bg-primary-700 transition-colors shadow-sm">
          {i.nav.getStarted}
        </a>

        <!-- Language Switch -->
        <a
          href={switchHref}
          data-lang-switcher
          data-target-lang={altLang}
          class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-600 hover:text-gray-900 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label={`Switch to ${languages[altLang]}`}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
          </svg>
          <span class="uppercase text-xs font-bold tracking-wide">{altLang}</span>
        </a>

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          class="md:hidden p-2 -mr-2 text-gray-600 hover:text-gray-900 rounded-lg hover:bg-gray-50"
          aria-label="Toggle menu"
          aria-expanded="false"
          id="mobile-menu-toggle"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>
  </Container>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-100 bg-white">
    <Container>
      <div class="py-4 space-y-1">
        {navLinks.map((link) => (
          link.children ? (
            <>
              <span class="block px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-wide">{link.label}</span>
              {link.children.map((child) => (
                <a
                  href={child.href}
                  class:list={[
                    'block px-6 py-3 text-base font-medium rounded-lg transition-colors',
                    currentPath === child.href || currentPath.startsWith(child.href + '/')
                      ? 'text-primary-600 bg-primary-50'
                      : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
                  ]}
                >
                  {child.label}
                </a>
              ))}
            </>
          ) : (
            <a
              href={link.href}
              class:list={[
                'block px-4 py-3 text-base font-medium rounded-lg transition-colors',
                currentPath === link.href
                  ? 'text-primary-600 bg-primary-50'
                  : 'text-gray-600 hover:text-gray-900 hover:bg-gray-50',
              ]}
            >
              {link.label}
            </a>
          )
        ))}
        <div class="pt-3 mt-3 border-t border-gray-100 space-y-3">
          <a
            href={switchHref}
            data-lang-switcher
            data-target-lang={altLang}
            class="flex items-center justify-center gap-2 w-full px-5 py-3 text-base font-medium text-gray-700 bg-gray-50 rounded-full hover:bg-gray-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
            </svg>
            {languages[altLang]}
          </a>
          <a href={`${APP_URL}/login`} class="block w-full text-center px-5 py-3 text-base font-semibold text-primary-600 bg-white border border-primary-600 rounded-full hover:bg-primary-50 transition-colors">
            {i.nav.signIn}
          </a>
          <a href="#" data-cal-link="berkan-bugday-rdudv5/30min" class="block w-full text-center px-5 py-3 text-base font-semibold text-white bg-primary-600 rounded-full hover:bg-primary-700 transition-colors">
            {i.nav.getStarted}
          </a>
        </div>
      </div>
    </Container>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));

    if (isOpen) {
      menuIcon?.setAttribute('d', 'M4 6h16M4 12h16M4 18h16');
    } else {
      menuIcon?.setAttribute('d', 'M6 18L18 6M6 6l12 12');
    }
  });

  // Language switcher preference handler
  const langSwitchers = document.querySelectorAll('[data-lang-switcher]');
  langSwitchers.forEach(switcher => {
    switcher.addEventListener('click', () => {
      const targetLang = switcher.getAttribute('data-target-lang');
      if (targetLang) {
        localStorage.setItem('preferred-lang', targetLang);
      }
    });
  });
</script>
