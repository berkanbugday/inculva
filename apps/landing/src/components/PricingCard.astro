---
export interface Props {
  name: string;
  price: string;
  period?: string;
  description: string;
  features: string[];
  cta: string;
  ctaHref: string;
  popular?: boolean;
}

const { name, price, period = '/mo', description, features, cta, ctaHref, popular = false } = Astro.props;
---

<div class:list={[
  'relative flex flex-col rounded-2xl border p-8 h-full',
  popular
    ? 'border-primary-600 shadow-glow bg-white scale-105 z-10'
    : 'border-gray-200 bg-white shadow-soft hover-lift',
]}>
  {popular && (
    <div class="absolute -top-4 left-1/2 -translate-x-1/2">
      <span class="inline-flex items-center px-4 py-1.5 rounded-full text-xs font-semibold bg-primary-600 text-white shadow-sm">
        Most Popular
      </span>
    </div>
  )}

  <div class="mb-6">
    <h3 class="text-lg font-semibold text-gray-900">{name}</h3>
    <p class="mt-1 text-sm text-gray-500">{description}</p>
  </div>

  <div class="mb-8">
    <span class="text-4xl font-bold text-gray-900">{price}</span>
    {price !== 'Custom' && (
      <span class="text-gray-500 text-sm">{period}</span>
    )}
  </div>

  <ul class="space-y-3 mb-8 flex-1" role="list">
    {features.map((feature) => (
      <li class="flex items-start gap-3">
        <svg class="w-5 h-5 text-primary-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        <span class="text-sm text-gray-600">{feature}</span>
      </li>
    ))}
  </ul>

  <a
    href={ctaHref}
    class:list={[
      'block w-full text-center py-3 px-6 rounded-xl font-semibold transition-all duration-200',
      popular
        ? 'bg-primary-600 text-white hover:bg-primary-700 shadow-sm hover:shadow-md'
        : 'bg-gray-50 text-gray-900 hover:bg-gray-100 border border-gray-200',
    ]}
  >
    {cta}
  </a>
</div>
