---
interface Props {
  posts: {
    title: { en: string; tr: string }
    slug: { current: string }
    slugTr?: { current: string }
    category?: string
  }[]
  lang: 'en' | 'tr'
}

const { posts, lang } = Astro.props
const basePath = lang === 'tr' ? '/tr/blog' : '/blog'
---

{posts.length > 0 && (
  <div class="sticky top-8">
    <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wide mb-4">
      {lang === 'tr' ? 'İlgili Yazılar' : 'Related Posts'}
    </h3>
    <div class="space-y-3">
      {posts.map((post) => {
        const slug = lang === 'tr' ? (post.slugTr?.current || post.slug.current) : post.slug.current
        return (
          <a
            href={`${basePath}/${slug}/`}
            class="block text-sm text-gray-600 hover:text-primary-600 transition-colors py-1"
          >
            {post.title[lang] || post.title.en}
          </a>
        )
      })}
    </div>
  </div>
)}
