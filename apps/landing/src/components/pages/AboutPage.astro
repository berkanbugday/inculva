---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import { t, getLocalizedPath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
---

<BaseLayout
  title={i.about.title}
  description={i.about.description}
  canonical="https://inculva.com/about"
  lang={lang}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50/60 to-white pt-20 pb-16 md:pt-28 md:pb-20">
    <Container narrow>
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {i.about.heroTitle1}
          <span class="text-gradient">{i.about.heroTitleHighlight}</span>
          {i.about.heroTitle2}
        </h1>
        <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          {i.about.heroDescription}
        </p>
      </div>
    </Container>
  </section>

  <!-- Mission -->
  <Section background="white">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900">{i.about.missionTitle}</h2>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.about.missionP1}
          </p>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.about.missionP2}
          </p>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.about.missionP3}
          </p>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-primary-100 to-accent-50 p-12 flex items-center justify-center aspect-square">
          <div class="text-center">
            <div class="text-6xl font-extrabold text-gradient">1B+</div>
            <p class="mt-4 text-gray-600 font-medium">{i.about.missionStat}</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Values -->
  <Section background="gray">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">{i.about.valuesTitle}</h2>
        <p class="mt-4 text-lg text-gray-600">{i.about.valuesDescription}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>',
            title: i.about.inclusionFirst,
            description: i.about.inclusionFirstDesc,
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456zM16.894 20.567L16.5 21.75l-.394-1.183a2.25 2.25 0 00-1.423-1.423L13.5 18.75l1.183-.394a2.25 2.25 0 001.423-1.423l.394-1.183.394 1.183a2.25 2.25 0 001.423 1.423l1.183.394-1.183.394a2.25 2.25 0 00-1.423 1.423z"/>',
            title: i.about.innovation,
            description: i.about.innovationDesc,
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18"/>',
            title: i.about.transparency,
            description: i.about.transparencyDesc,
          },
        ].map(({ icon, title, description }) => (
          <Card padding="lg">
            <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{description}</p>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Team -->
  <Section background="white" id="team">
    <Container>
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900">{i.about.teamTitle}</h2>
        <p class="mt-4 text-lg text-gray-600">{i.about.teamDescription}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-4xl mx-auto">
        {[
          { name: 'Berkan Bugday', role: i.about.founderCeo },
          { name: 'Sarah Chen', role: i.about.headOfAi },
          { name: 'Marcus Johnson', role: i.about.leadEngineer },
          { name: 'Emily Rodriguez', role: i.about.headOfDesign },
        ].map(({ name, role }) => (
          <div class="text-center">
            <div class="w-24 h-24 mx-auto rounded-2xl bg-gradient-to-br from-primary-100 to-accent-50 flex items-center justify-center mb-4">
              <span class="text-2xl font-bold text-primary-600">{name.split(' ').map((n) => n[0]).join('')}</span>
            </div>
            <h3 class="font-semibold text-gray-900">{name}</h3>
            <p class="text-sm text-gray-500">{role}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- CTA -->
  <Section background="gray" id="careers">
    <Container narrow>
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900">{i.about.joinTitle}</h2>
        <p class="mt-4 text-lg text-gray-600">{i.about.joinDescription}</p>
        <div class="mt-8">
          <a href={getLocalizedPath('/contact', lang)} class="inline-flex items-center px-8 py-4 text-lg font-semibold text-white bg-primary-600 rounded-full hover:bg-primary-700 transition-colors shadow-sm">
            {i.about.getInTouch}
          </a>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
