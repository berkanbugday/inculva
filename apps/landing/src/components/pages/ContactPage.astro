---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import { t, getLocalizedPath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
---

<BaseLayout
  title={i.contact.title}
  description={i.contact.description}
  canonical="https://inculva.com/contact"
  lang={lang}
>
  <!-- Hero -->
  <section class="bg-primary-50/30 pt-20 pb-4 md:pt-28 md:pb-8">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {i.contact.heroTitle1}<span class="text-gradient">{i.contact.heroTitleHighlight}</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto">
          {i.contact.heroDescription}
        </p>
      </div>
    </Container>
  </section>

  <Section background="white" class="!pt-12">
    <Container>
      <div class="grid lg:grid-cols-3 gap-12 lg:gap-16">
        <!-- Contact Form -->
        <div class="lg:col-span-2">
          <form class="space-y-6" action="#" method="POST" novalidate>
            <div class="grid sm:grid-cols-2 gap-6">
              <div>
                <label for="first-name" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.firstName}</label>
                <input
                  type="text"
                  id="first-name"
                  name="first-name"
                  autocomplete="given-name"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none"
                  placeholder="Jane"
                />
              </div>
              <div>
                <label for="last-name" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.lastName}</label>
                <input
                  type="text"
                  id="last-name"
                  name="last-name"
                  autocomplete="family-name"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none"
                  placeholder="Doe"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.email}</label>
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none"
                placeholder="jane@example.com"
              />
            </div>

            <div>
              <label for="company" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.company} <span class="text-gray-400">({i.contact.optional})</span></label>
              <input
                type="text"
                id="company"
                name="company"
                autocomplete="organization"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none"
                placeholder="Acme Corp"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.subject}</label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none"
              >
                <option value="" disabled selected>{i.contact.selectTopic}</option>
                <option value="sales">{i.contact.salesInquiry}</option>
                <option value="support">{i.contact.technicalSupport}</option>
                <option value="partnership">{i.contact.partnership}</option>
                <option value="enterprise">{i.contact.enterprisePlan}</option>
                <option value="other">{i.contact.other}</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-gray-700 mb-2">{i.contact.message}</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 bg-white text-gray-900 placeholder-gray-400 focus:border-primary-500 focus:ring-2 focus:ring-primary-500/20 transition-all outline-none resize-y"
                placeholder={i.contact.messagePlaceholder}
              ></textarea>
            </div>

            <Button variant="primary" size="lg" class="w-full sm:w-auto">
              {i.contact.sendMessage}
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
              </svg>
            </Button>
          </form>
        </div>

        <!-- Contact Info -->
        <div class="space-y-8">
          <div>
            <h2 class="text-lg font-semibold text-gray-900 mb-4">{i.contact.otherWays}</h2>
          </div>

          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-gray-900">{i.contact.emailLabel}</h3>
                <a href="mailto:hi@inculva.com" class="text-sm text-primary-600 hover:text-primary-700 transition-colors">
                  hi@inculva.com
                </a>
              </div>
            </div>

          </div>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
