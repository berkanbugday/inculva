---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import ContactForm from '@/components/ContactForm';
import { t, getLocalizedPath, type Lang } from '@/i18n';
import { getLocalizedCanonical, getBreadcrumbSchema, getWebPageSchema, SITE_URL } from '@/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);

const contactSchemas = [
  getBreadcrumbSchema([
    { name: i.nav.home, url: SITE_URL },
    { name: i.nav.contact, url: getLocalizedCanonical('/contact', lang) },
  ]),
  getWebPageSchema({
    name: i.contact.title,
    description: i.contact.description,
    url: getLocalizedCanonical('/contact', lang),
    type: 'ContactPage',
  }, lang),
];
---

<BaseLayout
  title={i.contact.title}
  description={i.contact.description}
  canonical={getLocalizedCanonical('/contact', lang)}
  lang={lang}
  jsonLd={contactSchemas}
>
  <!-- Hero -->
  <section class="bg-primary-50/30 pt-20 pb-4 md:pt-28 md:pb-8">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {i.contact.heroTitle1}<span class="text-gradient">{i.contact.heroTitleHighlight}</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto">
          {i.contact.heroDescription}
        </p>
        <p class="mt-4 text-base text-gray-500">
          <a href="mailto:hi@inculva.com" class="text-primary-600 hover:text-primary-700 font-medium transition-colors">hi@inculva.com</a>
        </p>
      </div>
    </Container>
  </section>

  <Section background="white" class="!pt-12">
    <Container>
      <div class="max-w-2xl mx-auto">
        <!-- Contact Form -->
        <div>
          <ContactForm client:load labels={{
            firstName: i.contact.firstName,
            lastName: i.contact.lastName,
            email: i.contact.email,
            company: i.contact.company,
            optional: i.contact.optional,
            subject: i.contact.subject,
            selectTopic: i.contact.selectTopic,
            salesInquiry: i.contact.salesInquiry,
            technicalSupport: i.contact.technicalSupport,
            partnership: i.contact.partnership,
            enterprisePlan: i.contact.enterprisePlan,
            other: i.contact.other,
            message: i.contact.message,
            messagePlaceholder: i.contact.messagePlaceholder,
            sendMessage: i.contact.sendMessage,
            sending: i.contact.sending,
            successTitle: i.contact.successTitle,
            successDescription: i.contact.successDescription,
            errorTitle: i.contact.errorTitle,
            errorDescription: i.contact.errorDescription,
            validationFirstName: i.contact.validationFirstName,
            validationLastName: i.contact.validationLastName,
            validationEmail: i.contact.validationEmail,
            validationSubject: i.contact.validationSubject,
            validationMessage: i.contact.validationMessage,
          }} />
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
