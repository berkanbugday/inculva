---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Card from '@/components/Card.astro';
import Button from '@/components/Button.astro';
import { t, getLocalizedPath, type Lang } from '@/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
const CDN_URL = import.meta.env.PUBLIC_CDN_URL || 'https://cdn.inculva.com';
---

<BaseLayout
  title={i.features.title}
  description={i.features.description}
  canonical="https://inculva.com/features"
  lang={lang}
>
  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-50/60 to-white pt-20 pb-16 md:pt-28 md:pb-20">
    <Container>
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {i.features.heroTitle1}
          <span class="text-gradient">{i.features.heroTitleHighlight}</span>
        </h1>
        <p class="mt-6 text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          {i.features.heroDescription}
        </p>
      </div>
    </Container>
  </section>

  <!-- Automated Scanning -->
  <Section background="white" class="reveal-on-scroll">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-50 text-primary-700 text-sm font-medium mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5M14.25 3.104c.251.023.501.05.75.082M19.8 14.5l-2.55 7.156a.91.91 0 01-.857.644H7.607a.91.91 0 01-.857-.644L4.2 14.5m15.6 0h-15.6"/></svg>
            {i.features.automatedBadge}
          </div>
          <h2 class="text-3xl font-bold text-gray-900">{i.features.scanningTitle}</h2>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.features.scanningDescription}
          </p>
          <ul class="mt-6 space-y-3">
            {(i.features.scanningFeatures as string[]).map((item) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-primary-100 to-accent-50 p-8 aspect-square flex items-center justify-center">
          <div class="text-center">
            <div class="w-24 h-24 mx-auto rounded-2xl bg-white shadow-soft flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5"/></svg>
            </div>
            <p class="text-sm font-medium text-primary-700">{i.features.deepAnalysis}</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Automated Fixes -->
  <Section background="gray" class="reveal-on-scroll">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="order-2 lg:order-1 rounded-2xl bg-gradient-to-br from-accent-50 to-primary-50 p-8 aspect-square flex items-center justify-center">
          <div class="text-center">
            <div class="w-24 h-24 mx-auto rounded-2xl bg-white shadow-soft flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17l-5.684 5.684a1.875 1.875 0 01-2.652-2.652l5.684-5.684m0 0L3.382 7.13a2.625 2.625 0 013.712-3.712l5.388 5.388m-3.07 3.07l7.068-7.068 2.37 2.37a.75.75 0 010 1.06l-7.068 7.069-2.37-2.37z"/></svg>
            </div>
            <p class="text-sm font-medium text-accent-700">{i.features.smartAutoFix}</p>
          </div>
        </div>
        <div class="order-1 lg:order-2">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-50 text-accent-700 text-sm font-medium mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.42 15.17l-5.684 5.684a1.875 1.875 0 01-2.652-2.652l5.684-5.684"/></svg>
            {i.features.automatedBadge}
          </div>
          <h2 class="text-3xl font-bold text-gray-900">{i.features.fixesTitle}</h2>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.features.fixesDescription}
          </p>
          <ul class="mt-6 space-y-3">
            {(i.features.fixesFeatures as string[]).map((item) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-accent-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Monitoring -->
  <Section background="white" class="reveal-on-scroll">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-50 text-primary-700 text-sm font-medium mb-4">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75z"/></svg>
            {i.features.realTimeBadge}
          </div>
          <h2 class="text-3xl font-bold text-gray-900">{i.features.monitoringTitle}</h2>
          <p class="mt-4 text-gray-600 leading-relaxed">
            {i.features.monitoringDescription}
          </p>
          <ul class="mt-6 space-y-3">
            {(i.features.monitoringFeatures as string[]).map((item) => (
              <li class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                <span class="text-gray-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="rounded-2xl bg-gradient-to-br from-primary-100 to-primary-50 p-8 aspect-square flex items-center justify-center">
          <div class="text-center">
            <div class="w-24 h-24 mx-auto rounded-2xl bg-white shadow-soft flex items-center justify-center mb-4">
              <svg class="w-12 h-12 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/></svg>
            </div>
            <p class="text-sm font-medium text-primary-700">{i.features.monitoring247}</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Integration Section -->
  <section class="bg-gray-900 py-14 md:py-20 overflow-hidden reveal-on-scroll" id="integrations">
    <Container>
      <div class="text-center mb-10 md:mb-14">
        <h2 class="text-2xl sm:text-3xl font-bold text-white">{i.features.worksWithTitle}</h2>
        <p class="mt-3 text-gray-400 text-base max-w-lg mx-auto">{i.features.worksWithDescription}</p>
      </div>
    </Container>

    <!-- Carousel Row 1 — scrolls left -->
    <div class="relative">
      <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-gray-900 to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-gray-900 to-transparent z-10 pointer-events-none"></div>
      <div class="marquee-track">
        <div class="marquee-scroll">
          {[
            { name: 'React', icon: 'react', color: '61DAFB' },
            { name: 'Next.js', icon: 'nextdotjs', color: 'FFFFFF' },
            { name: 'Vue.js', icon: 'vuedotjs', color: '4FC08D' },
            { name: 'Angular', icon: 'angular', color: 'DD0031' },
            { name: 'Svelte', icon: 'svelte', color: 'FF3E00' },
            { name: 'WordPress', icon: 'wordpress', color: '21759B' },
            { name: 'Shopify', icon: 'shopify', color: '7AB55C' },
            { name: 'Wix', icon: 'wix', color: '0C6EFC' },
            { name: 'Squarespace', icon: 'squarespace', color: 'FFFFFF' },
            { name: 'Webflow', icon: 'webflow', color: '4353FF' },
          ].map(({ name, icon, color }) => (
            <div class="marquee-item">
              <img src={`https://cdn.simpleicons.org/${icon}/${color}`} alt={name} class="w-7 h-7" loading="lazy" />
              <span class="text-sm font-medium text-gray-300">{name}</span>
            </div>
          ))}
          {[
            { name: 'React', icon: 'react', color: '61DAFB' },
            { name: 'Next.js', icon: 'nextdotjs', color: 'FFFFFF' },
            { name: 'Vue.js', icon: 'vuedotjs', color: '4FC08D' },
            { name: 'Angular', icon: 'angular', color: 'DD0031' },
            { name: 'Svelte', icon: 'svelte', color: 'FF3E00' },
            { name: 'WordPress', icon: 'wordpress', color: '21759B' },
            { name: 'Shopify', icon: 'shopify', color: '7AB55C' },
            { name: 'Wix', icon: 'wix', color: '0C6EFC' },
            { name: 'Squarespace', icon: 'squarespace', color: 'FFFFFF' },
            { name: 'Webflow', icon: 'webflow', color: '4353FF' },
          ].map(({ name, icon, color }) => (
            <div class="marquee-item" aria-hidden="true">
              <img src={`https://cdn.simpleicons.org/${icon}/${color}`} alt="" class="w-7 h-7" loading="lazy" />
              <span class="text-sm font-medium text-gray-300">{name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Carousel Row 2 — scrolls right -->
    <div class="relative mt-5">
      <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-gray-900 to-transparent z-10 pointer-events-none"></div>
      <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-gray-900 to-transparent z-10 pointer-events-none"></div>
      <div class="marquee-track">
        <div class="marquee-scroll marquee-reverse">
          {[
            { name: 'Drupal', icon: 'drupal', color: '0678BE' },
            { name: 'Joomla', icon: 'joomla', color: '5091CD' },
            { name: 'BigCommerce', icon: 'bigcommerce', color: '121118' },
            { name: 'Gatsby', icon: 'gatsby', color: '663399' },
            { name: 'Nuxt', icon: 'nuxt', color: '00DC82' },
            { name: 'Astro', icon: 'astro', color: 'BC52EE' },
            { name: 'Laravel', icon: 'laravel', color: 'FF2D20' },
            { name: 'Ruby on Rails', icon: 'rubyonrails', color: 'D30001' },
            { name: 'Django', icon: 'django', color: '092E20' },
          ].map(({ name, icon, color }) => (
            <div class="marquee-item">
              <img src={`https://cdn.simpleicons.org/${icon}/${color}`} alt={name} class="w-7 h-7" loading="lazy" />
              <span class="text-sm font-medium text-gray-300">{name}</span>
            </div>
          ))}
          {[
            { name: 'Drupal', icon: 'drupal', color: '0678BE' },
            { name: 'Joomla', icon: 'joomla', color: '5091CD' },
            { name: 'BigCommerce', icon: 'bigcommerce', color: '121118' },
            { name: 'Gatsby', icon: 'gatsby', color: '663399' },
            { name: 'Nuxt', icon: 'nuxt', color: '00DC82' },
            { name: 'Astro', icon: 'astro', color: 'BC52EE' },
            { name: 'Laravel', icon: 'laravel', color: 'FF2D20' },
            { name: 'Ruby on Rails', icon: 'rubyonrails', color: 'D30001' },
            { name: 'Django', icon: 'django', color: '092E20' },
          ].map(({ name, icon, color }) => (
            <div class="marquee-item" aria-hidden="true">
              <img src={`https://cdn.simpleicons.org/${icon}/${color}`} alt="" class="w-7 h-7" loading="lazy" />
              <span class="text-sm font-medium text-gray-300">{name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    .marquee-track {
      overflow: hidden;
      width: 100%;
    }
    .marquee-scroll {
      display: flex;
      width: max-content;
      animation: marquee-left 35s linear infinite;
    }
    .marquee-reverse {
      animation: marquee-right 35s linear infinite;
    }
    .marquee-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.625rem 1.5rem;
      margin: 0 0.375rem;
      border-radius: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.04);
      white-space: nowrap;
      flex-shrink: 0;
      transition: background 0.2s, border-color 0.2s;
    }
    .marquee-item:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.15);
    }
    @keyframes marquee-left {
      0% { transform: translateX(0); }
      100% { transform: translateX(-50%); }
    }
    @keyframes marquee-right {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .marquee-scroll {
        animation: none;
      }
    }
  </style>

  <!-- CTA -->
  <Section background="white" class="reveal-on-scroll">
    <Container narrow>
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">{i.features.ctaTitle}</h2>
        <p class="mt-4 text-lg text-gray-600">{i.features.ctaDescription}</p>
        <div class="mt-8">
          <Button href="https://app.inculva.com" size="lg">{i.features.startFreeTrial}</Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
