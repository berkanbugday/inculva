---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import { t, type Lang } from '@/i18n';
import { getLocalizedCanonical, getBreadcrumbSchema, getWebPageSchema, SITE_URL } from '@/lib/seo';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = t(lang);
const tou = i.termsOfUse;

const termsSchemas = [
  getBreadcrumbSchema([
    { name: i.nav.home, url: SITE_URL },
    { name: tou.title, url: getLocalizedCanonical('/terms-of-use', lang) },
  ]),
  getWebPageSchema({
    name: tou.title,
    description: tou.description,
    url: getLocalizedCanonical('/terms-of-use', lang),
  }),
];
---

<BaseLayout
  title={tou.title}
  description={tou.description}
  canonical={getLocalizedCanonical('/terms-of-use', lang)}
  lang={lang}
  jsonLd={termsSchemas}
>
  <!-- Hero -->
  <section class="bg-primary-50/30 pt-20 pb-16 md:pt-28 md:pb-20">
    <Container narrow>
      <div class="text-center">
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {tou.heroTitle1}
          <span class="text-gradient">{tou.heroTitleHighlight}</span>
        </h1>
        <p class="mt-4 text-sm text-gray-500">{tou.lastUpdated}</p>
      </div>
    </Container>
  </section>

  <!-- Content -->
  <Section background="white">
    <Container narrow>
      <div class="prose prose-gray max-w-none">
        <p class="text-lg text-gray-600 leading-relaxed">{tou.intro}</p>

        <!-- Section 1 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section1Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section1P1}</p>

        <!-- Section 2 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section2Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section2P1}</p>
        <ul class="mt-3 space-y-2">
          {(tou.section2Items as string[]).map((item) => (
            <li class="flex items-start gap-2 text-gray-600">
              <svg class="w-5 h-5 text-primary-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <!-- Section 3 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section3Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section3P1}</p>
        <p class="text-gray-600 leading-relaxed mt-3">{tou.section3P2}</p>

        <!-- Section 4 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section4Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section4P1}</p>
        <ul class="mt-3 space-y-2">
          {(tou.section4Items as string[]).map((item) => (
            <li class="flex items-start gap-2 text-gray-600">
              <svg class="w-5 h-5 text-primary-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              {item}
            </li>
          ))}
        </ul>

        <!-- Section 5 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section5Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section5P1}</p>
        <p class="text-gray-600 leading-relaxed mt-3">{tou.section5P2}</p>

        <!-- Section 6 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section6Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section6P1}</p>
        <p class="text-gray-600 leading-relaxed mt-3">{tou.section6P2}</p>

        <!-- Section 7 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section7Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section7P1}</p>
        <p class="text-gray-600 leading-relaxed mt-3">{tou.section7P2}</p>

        <!-- Section 8 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section8Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section8P1}</p>
        <p class="text-gray-600 leading-relaxed mt-3">{tou.section8P2}</p>

        <!-- Section 9 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section9Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section9P1}</p>

        <!-- Section 10 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section10Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section10P1}</p>

        <!-- Section 11 -->
        <h2 class="text-xl font-bold text-gray-900 mt-10 mb-4">{tou.section11Title}</h2>
        <p class="text-gray-600 leading-relaxed">{tou.section11P1}</p>
        <p class="mt-2">
          <a href={`mailto:${tou.contactEmail}`} class="text-primary-600 hover:text-primary-700 font-medium transition-colors">
            {tou.contactEmail}
          </a>
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
