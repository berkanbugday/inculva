---
import KBLayout from '../../components/kb/KBLayout.astro'
import RelatedPosts from '../../components/blog/RelatedPosts.astro'
import RelatedRules from '../../components/kb/RelatedRules.astro'
import { getAllBlogPosts, getBlogPostBySlug } from '../../lib/sanity'
import { portableTextToHtml } from '../../lib/portable-text'
import { SITE_URL } from '../../lib/seo'

export async function getStaticPaths() {
  const posts = await getAllBlogPosts()
  return posts.map((post) => ({
    params: { slug: post.slug.current },
  }))
}

const { slug } = Astro.params
const post = await getBlogPostBySlug(slug!)

if (!post) {
  return Astro.redirect('/blog/')
}

const contentHtml = post.content?.en ? portableTextToHtml(post.content.en) : ''
const trSlug = post.slugTr?.current || post.slug.current

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title.en,
  description: post.description?.en || '',
  url: `${SITE_URL}/blog/${post.slug.current}/`,
  datePublished: post.publishedAt,
  inLanguage: 'en',
  publisher: {
    '@type': 'Organization',
    name: 'inculva',
    url: SITE_URL,
  },
}

const categoryLabels: Record<string, string> = {
  accessibility: 'Accessibility',
  legal: 'Legal',
  wcag: 'WCAG',
  tools: 'Tools',
  news: 'News',
}

const turkishCharRegex = /[çğıöşüÇĞİÖŞÜ]/
const filteredTags = post.tags?.filter((tag) => {
  return !turkishCharRegex.test(tag)
}) || []
---

<KBLayout
  title={post.seo?.en?.metaTitle || `${post.title.en} | inculva`}
  description={post.seo?.en?.metaDescription || post.description?.en || ''}
  lang="en"
  breadcrumbs={[
    { label: 'Blog', href: '/blog/' },
    { label: post.title.en, href: `/blog/${post.slug.current}/` },
  ]}
  jsonLd={jsonLd}
  hreflangOverrides={[
    { lang: 'en', url: `${SITE_URL}/blog/${post.slug.current}/` },
    { lang: 'tr', url: `${SITE_URL}/tr/blog/${trSlug}/` },
    { lang: 'x-default', url: `${SITE_URL}/blog/${post.slug.current}/` },
  ]}
  alternateHref={`/tr/blog/${trSlug}/`}
>
  <div class="lg:grid lg:grid-cols-[1fr_280px] lg:gap-12">
    <article class="max-w-4xl">
      <header class="mb-8">
        <span class="text-sm font-medium text-primary-600 uppercase tracking-wide">
          {categoryLabels[post.category] || post.category}
        </span>
        <h1 class="text-4xl font-bold text-gray-900 mt-2 mb-4">{post.title.en}</h1>
        {post.description?.en && (
          <p class="text-xl text-gray-600">{post.description.en}</p>
        )}
        {post.publishedAt && (
          <time class="text-sm text-gray-400 mt-2 block">
            {new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        )}
      </header>

      <div class="prose prose-lg prose-gray max-w-none" set:html={contentHtml} />

      {filteredTags.length > 0 && (
        <div class="mt-8 pt-6 border-t border-gray-200 flex flex-wrap gap-2">
          {filteredTags.map((tag) => (
            <span class="text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full">{tag}</span>
          ))}
        </div>
      )}
    </article>

    <aside class="hidden lg:block space-y-8">
      <RelatedPosts posts={post.relatedPosts || []} lang="en" />
      <RelatedRules rules={post.relatedWcagRules || []} lang="en" />
    </aside>
  </div>
</KBLayout>
