---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Section from '@/components/Section.astro';
import Button from '@/components/Button.astro';
import Card from '@/components/Card.astro';
---

<BaseLayout
  title="Inculva"
  description="AI-powered web accessibility platform that helps websites achieve WCAG compliance automatically. Make your website accessible to everyone."
  canonical="https://inculva.com"
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-primary-50/60 via-white to-white pt-20 pb-28 md:pt-28 md:pb-36">
    <!-- Background decoration -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
      <div class="absolute -top-40 -right-40 w-80 h-80 bg-primary-200/30 rounded-full blur-3xl"></div>
      <div class="absolute top-20 -left-20 w-60 h-60 bg-accent-200/20 rounded-full blur-3xl"></div>
    </div>

    <Container class="relative">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-50 border border-primary-100 text-primary-700 text-sm font-medium mb-8 animate-fade-in">
          <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
          AI-Powered Accessibility Platform
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight leading-[1.1] animate-slide-up">
          Make your website
          <span class="text-gradient"> accessible </span>
          to everyone
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed animate-slide-up" style="animation-delay: 100ms;">
          Inculva uses AI to detect, fix, and monitor web accessibility issues automatically. Achieve WCAG 2.1 AA compliance without rewriting your code.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4 animate-slide-up" style="animation-delay: 200ms;">
          <Button href="https://app.inculva.com" size="lg">
            Start Free Trial
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </Button>
          <Button href="/features" variant="secondary" size="lg">
            See How It Works
          </Button>
        </div>

        <p class="mt-6 text-sm text-gray-500">No credit card required • Free plan available</p>
      </div>
    </Container>
  </section>

  <!-- Trusted By Section -->
  <Section background="white" class="!py-12 md:!py-16 border-y border-gray-100">
    <Container>
      <p class="text-center text-sm font-medium text-gray-400 uppercase tracking-wider mb-8">Trusted by forward-thinking teams</p>
      <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-40 grayscale">
        {['Acme Corp', 'Globex', 'Initech', 'Umbrella', 'Cyberdyne'].map((name) => (
          <span class="text-xl font-bold text-gray-900">{name}</span>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Features Grid Section -->
  <Section background="white" id="features-preview">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          Everything you need for
          <span class="text-gradient">web accessibility</span>
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          A complete platform to scan, fix, and monitor your website's accessibility compliance.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 14.5M14.25 3.104c.251.023.501.05.75.082M19.8 14.5l-2.55 7.156a.91.91 0 01-.857.644H7.607a.91.91 0 01-.857-.644L4.2 14.5m15.6 0h-15.6"/>',
            title: 'AI-Powered Scanning',
            description: 'Automatically detect WCAG violations across your entire website with intelligent AI-driven analysis.',
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.42 15.17l-5.684 5.684a1.875 1.875 0 01-2.652-2.652l5.684-5.684m0 0L3.382 7.13a2.625 2.625 0 013.712-3.712l5.388 5.388m-3.07 3.07l7.068-7.068 2.37 2.37a.75.75 0 010 1.06l-7.068 7.069-2.37-2.37z"/>',
            title: 'One-Click Fixes',
            description: 'Apply automated accessibility fixes with a single click. No developer needed for common issues.',
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>',
            title: 'Compliance Dashboard',
            description: 'Track your accessibility score in real-time with a comprehensive compliance dashboard.',
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/>',
            title: 'Multi-Language Support',
            description: 'Support for 41+ languages including RTL layouts. Serve accessibility widgets globally.',
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/>',
            title: 'Easy Integration',
            description: 'Add a single line of code to your website. Works with any framework, CMS, or static site.',
          },
          {
            icon: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>',
            title: 'Legal Protection',
            description: 'Stay compliant with ADA, Section 508, EN 301 549, and other accessibility regulations.',
          },
        ].map(({ icon, title, description }) => (
          <Card padding="lg">
            <div class="w-12 h-12 rounded-xl bg-primary-50 flex items-center justify-center mb-4">
              <svg class="w-6 h-6 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900">{title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{description}</p>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <!-- How It Works Section -->
  <Section background="gray">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          Get compliant in <span class="text-gradient">three steps</span>
        </h2>
        <p class="mt-4 text-lg text-gray-600">
          From installation to full WCAG compliance in minutes, not months.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
        {[
          {
            step: '01',
            title: 'Install the Widget',
            description: 'Add a single script tag to your website. No dependencies, no build step required.',
          },
          {
            step: '02',
            title: 'AI Scans & Fixes',
            description: 'Our AI analyzes every page, detects violations, and applies fixes automatically.',
          },
          {
            step: '03',
            title: 'Stay Compliant',
            description: 'Continuous monitoring ensures your site remains accessible as you make changes.',
          },
        ].map(({ step, title, description }) => (
          <div class="relative text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white border border-gray-200 shadow-soft mb-6">
              <span class="text-2xl font-bold text-gradient">{step}</span>
            </div>
            <h3 class="text-xl font-semibold text-gray-900">{title}</h3>
            <p class="mt-3 text-gray-600 leading-relaxed">{description}</p>
          </div>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Stats Section -->
  <Section background="white">
    <Container>
      <div class="relative rounded-3xl bg-gradient-to-br from-primary-600 to-primary-800 px-8 py-16 md:py-20 overflow-hidden">
        <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
          <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/2"></div>
          <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/2 -translate-x-1/2"></div>
        </div>
        <div class="relative grid sm:grid-cols-3 gap-8 text-center">
          {[
            { value: '99.8%', label: 'Uptime SLA' },
            { value: '50ms', label: 'Average Widget Load' },
            { value: '10K+', label: 'Websites Protected' },
          ].map(({ value, label }) => (
            <div>
              <div class="text-4xl md:text-5xl font-bold text-white">{value}</div>
              <div class="mt-2 text-primary-200 font-medium">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA Section -->
  <Section background="gray">
    <Container narrow>
      <div class="text-center">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">
          Ready to make your website accessible?
        </h2>
        <p class="mt-4 text-lg text-gray-600 max-w-xl mx-auto">
          Join thousands of websites using Inculva to achieve WCAG compliance automatically.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button href="https://app.inculva.com" size="lg">
            Start Free Trial
          </Button>
          <Button href="/contact" variant="secondary" size="lg">
            Talk to Sales
          </Button>
        </div>
      </div>
    </Container>
  </Section>

  <!-- FAQ Section -->
  <Section background="white">
    <Container narrow>
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900">Frequently asked questions</h2>
      </div>

      <div class="space-y-4">
        {[
          {
            q: 'What is WCAG compliance?',
            a: 'WCAG (Web Content Accessibility Guidelines) is an international standard for making web content accessible to people with disabilities. Compliance ensures your website can be used by everyone, including people who use screen readers, have low vision, or have motor impairments.',
          },
          {
            q: 'Do I need technical knowledge to use Inculva?',
            a: 'No. Inculva is designed to be used by anyone. Simply paste one line of code into your website, and our AI handles the rest. No coding skills are needed for common accessibility fixes.',
          },
          {
            q: 'Does Inculva slow down my website?',
            a: 'No. The Inculva widget is loaded asynchronously and optimized for performance. It typically adds less than 50ms to your page load time and does not affect your Core Web Vitals.',
          },
          {
            q: 'Which accessibility standards does Inculva support?',
            a: 'Inculva supports WCAG 2.1 Level AA, ADA (Americans with Disabilities Act), Section 508, EN 301 549, and other regional accessibility regulations.',
          },
          {
            q: 'Can I try Inculva for free?',
            a: 'Yes! We offer a free plan that includes basic accessibility scanning and fixes for a single website. No credit card required to get started.',
          },
        ].map(({ q, a }) => (
          <details class="group bg-white rounded-2xl border border-gray-100 shadow-soft">
            <summary class="flex items-center justify-between cursor-pointer px-6 py-5 text-left font-semibold text-gray-900 hover:text-primary-600 transition-colors">
              {q}
              <svg class="w-5 h-5 text-gray-400 group-open:rotate-180 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <div class="px-6 pb-5 text-gray-600 leading-relaxed">
              {a}
            </div>
          </details>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
