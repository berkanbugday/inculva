# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/inculva"

# ── Polar.sh Billing ───────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=polar_oat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_WEBHOOK_SECRET=polar_whs_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
POLAR_SERVER=sandbox
POLAR_SMALL_MONTHLY_PRODUCT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_SMALL_ANNUAL_PRODUCT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
POLAR_MEDIUM_MONTHLY_PRODUCT_ID=
POLAR_MEDIUM_ANNUAL_PRODUCT_ID=
POLAR_LARGE_MONTHLY_PRODUCT_ID=
POLAR_LARGE_ANNUAL_PRODUCT_ID=

# ── Server ────────────────────────────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# ── Better Auth ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# ── Email — Resend (resend.com) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=inculva <hi@inculva.com>

# ── App URL (used in email links) ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Widget ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CDN_URL=https://cdn.inculva.com
NEXT_PUBLIC_LANDING_URL=https://inculva.com
NEXT_PUBLIC_WIDGET_URL=http://localhost:3001/widget.js

# ── Widget build-time env (packages/widget — injected by Vite define) ─────────
VITE_API_URL=http://localhost:3001
VITE_CDN_URL=https://cdn.inculva.com

# ── Scanning infrastructure ────────────────────────────────────────────────────
INTERNAL_API_SECRET=your-internal-api-secret
REDIS_URL=redis://localhost:6379

# ── OAuth Providers ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
