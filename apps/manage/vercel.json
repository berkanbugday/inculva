{
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web...",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    },
    {
      "path": "/api/cron/drip-emails",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 */6 * * *"
    }
  ]
}
