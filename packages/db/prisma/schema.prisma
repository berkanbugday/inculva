generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth (Better Auth compatible) ───────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    Boolean   @default(false)
  name             String?
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Role
  role             String    @default("user")  // "user" | "admin"

  // Billing
  plan             String    @default("free")  // "free" | "small" | "medium" | "large"
  polarCustomerId  String?   @unique

  // Usage alerts — track when monthly threshold emails were last sent
  usageAlertSent80  DateTime?
  usageAlertSent100 DateTime?

  // Email drip flags
  dripDay3Sent  Boolean @default(false)
  dripDay7Sent  Boolean @default(false)
  dripDay30Sent Boolean @default(false)

  // Moderation
  bannedAt DateTime?

  sessions      Session[]
  accounts      Account[]
  sites         Site[]
  subscription  Subscription?
  notifications Notification[]

}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
}

// ─── Billing ─────────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  polarSubscriptionId  String    @unique
  polarProductId       String
  plan                 String    // "small" | "medium" | "large"
  interval             String    // "month" | "year"
  status               String    // "active" | "trialing" | "past_due" | "canceled"
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Core Domain ─────────────────────────────────────────────────────────────

model Site {
  id        String   @id @default(cuid())
  name      String
  domain    String   @unique
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Health monitoring
  lastHealthCheck DateTime?
  healthStatus    String?   // "healthy" | "degraded"

  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  widgetConfig WidgetConfig?
  widgetEvents WidgetEvent[]
  widgetLoads  WidgetLoad[]

  // Scanning
  scans               Scan[]
  scanIssues          ScanIssue[]
  scanSchedule        ScanSchedule?
  complianceSnapshots ComplianceSnapshot[]
}

model WidgetConfig {
  id           String   @id @default(cuid())
  siteId       String   @unique
  position     String   @default("bottom-right")
  theme        String   @default("auto")
  primaryColor String   @default("#0066cc")
  language     String   @default("en")

  // Features
  textResizing       Boolean @default(true)
  highContrast       Boolean @default(true)
  dyslexiaFont       Boolean @default(true)
  cursorEnhancement  Boolean @default(true)
  keyboardNavigation Boolean @default(true)
  readingGuide       Boolean @default(true)
  screenReader       Boolean @default(true)
  pauseAnimations    Boolean @default(true)
  // WCAG 2.1 / 2.2 additions
  textSpacing        Boolean @default(true)
  highlightLinks     Boolean @default(true)
  colorBlindMode     Boolean @default(true)
  largeClickTargets  Boolean @default(true)
  focusHighlight     Boolean @default(true)
  grayscale          Boolean @default(true)
  // WCAG 2.4.1 A + 1.4.2 A (ADA/EAA)
  skipNavigation     Boolean @default(true)
  muteMedia          Boolean @default(true)
  // P1 — additional accessibility aids
  readingMask        Boolean @default(true)
  textAlign          Boolean @default(true)
  saturation         Boolean @default(true)
  blueLightFilter    Boolean @default(true)
  hideImages         Boolean @default(true)
  darkMode           Boolean @default(true)
  contentMagnifier   Boolean @default(true)
  toolTips           Boolean @default(true)
  sustainabilityMode Boolean @default(false)
  slowCursor         Boolean @default(true)
  dictionary         Boolean @default(false)
  lineHeight         Boolean @default(true)
  highlightTitles    Boolean @default(true)

  // Accessibility Profiles — control which one-click profiles appear in widget
  profileAdhd          Boolean @default(true)
  profileBlind         Boolean @default(true)
  profileLowVision     Boolean @default(true)
  profileColorBlind    Boolean @default(true)
  profileDyslexia      Boolean @default(true)
  profileMotorImpaired Boolean @default(true)
  profileCognitive     Boolean @default(true)
  profileSeizure       Boolean @default(true)
  profileParkinson     Boolean @default(true)

  // EAA Article 13 — accessibility statement URL
  accessibilityStatementUrl String?

  // White-label (Large plan only) — null=show "Powered by inculva", ""=hide, custom string=show that
  whiteLabelText String?

  // Trigger button customization
  buttonSize   String @default("medium")            // "small" | "medium" | "large"
  buttonIcon   String @default("universal-access")  // trigger button icon key

  // Last WCAG scan result — persisted so the badge can reflect actual state
  lastScanViolations  Int?
  lastScanAt          DateTime?
  lastComplianceScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}

model WidgetEvent {
  id        String   @id @default(cuid())
  siteId    String
  sessionId String
  event     String
  feature   String?
  createdAt DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([siteId, createdAt])
}

// Daily aggregated domain load counts — tracks which hostnames embed the widget
model WidgetLoad {
  id      String   @id @default(cuid())
  siteId  String
  domain  String
  date    DateTime // truncated to UTC day
  count   Int      @default(1)

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, domain, date])
  @@index([siteId, date])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    // "plan_upgraded" | "usage_warning" | "usage_limit" | "payment_failed"
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Accessibility Scanning ──────────────────────────────────────────────────

model Scan {
  id          String    @id @default(cuid())
  siteId      String
  status      String    @default("pending") // "pending" | "crawling" | "scanning" | "completed" | "failed"
  trigger     String    @default("manual")  // "manual" | "scheduled" | "webhook"

  // Configuration snapshot at time of scan
  maxPages    Int       @default(1)
  wcagLevel   String    @default("AA") // "A" | "AA" | "AAA"

  // Aggregate results (computed on completion)
  totalPages       Int?
  totalViolations  Int?
  totalPasses      Int?
  totalIncomplete  Int?
  complianceScore  Float? // 0-100 percentage

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Error info if failed
  errorMessage String?

  site        Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  pages       ScanPage[]
  issues      ScanIssue[]
  passedRules ScanPassedRule[]
  incompleteRules ScanIncomplete[]

  @@index([siteId, createdAt])
  @@index([siteId, status])
}

model ScanPage {
  id     String @id @default(cuid())
  scanId String
  url    String
  status String @default("pending") // "pending" | "scanning" | "completed" | "failed"

  // Per-page results
  violations   Int?
  passes       Int?
  incomplete   Int?
  score        Float?
  errorMessage String?

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())

  scan        Scan              @relation(fields: [scanId], references: [id], onDelete: Cascade)
  issues      ScanIssue[]
  passedRules ScanPassedRule[]
  incompleteRules ScanIncomplete[]

  @@index([scanId])
  @@unique([scanId, url])
}

model ScanIssue {
  id     String @id @default(cuid())
  scanId String
  pageId String
  siteId String

  // Rule identification
  ruleId      String // e.g. "img-alt", "color-contrast"
  description String
  impact      String // "critical" | "serious" | "moderate" | "minor"
  wcag        String // "1.1.1", "2.4.4", etc.
  wcagLevel   String // "A" | "AA" | "AAA"
  category    String // "perceivable" | "operable" | "understandable" | "robust"

  // Element context
  selector String? // CSS selector of affected element
  html     String? // Truncated outer HTML snippet
  helpUrl  String?

  // Issue lifecycle
  status      String    @default("open") // "open" | "fixed" | "ignored" | "false_positive"
  firstSeenAt DateTime  @default(now())
  fixedAt     DateTime?

  // AI fix suggestion (populated async)
  fixSuggestion String?

  createdAt DateTime @default(now())

  scan Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page ScanPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  site Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId, ruleId, selector])
  @@index([scanId])
  @@index([pageId])
  @@index([siteId, status])
}

model ScanPassedRule {
  id     String @id @default(cuid())
  scanId String
  pageId String

  ruleId      String // e.g. "img-alt", "color-contrast"
  description String // Human-readable rule description
  helpText    String? // Short help text from axe-core
  wcag        String // "1.1.1", "2.4.4", etc.
  wcagLevel   String // "A" | "AA" | "AAA"
  category    String // "perceivable" | "operable" | "understandable" | "robust"
  helpUrl     String? // Link to WCAG documentation
  nodeCount   Int     @default(1) // Number of elements that passed this rule

  createdAt DateTime @default(now())

  scan Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page ScanPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([pageId])
  @@unique([scanId, pageId, ruleId])
}

model ScanIncomplete {
  id     String @id @default(cuid())
  scanId String
  pageId String

  ruleId      String // e.g. "color-contrast"
  description String // Human-readable rule description
  impact      String // "critical" | "serious" | "moderate" | "minor"
  wcag        String // "1.4.3", etc.
  wcagLevel   String // "A" | "AA" | "AAA"
  category    String // "perceivable" | "operable" | "understandable" | "robust"
  selector    String? // CSS selector of affected element
  html        String? // Truncated outer HTML snippet
  helpUrl     String?
  message     String // Why axe-core couldn't determine pass/fail

  createdAt DateTime @default(now())

  scan Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  page ScanPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([pageId])
  @@unique([scanId, pageId, ruleId, selector])
}

model ComplianceSnapshot {
  id         String   @id @default(cuid())
  siteId     String
  date       DateTime // truncated to UTC day
  score      Float
  violations Int
  passes     Int
  scanId     String?

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, date])
  @@index([siteId, date])
}

model ScanSchedule {
  id        String    @id @default(cuid())
  siteId    String    @unique
  frequency String    @default("weekly") // "daily" | "weekly" | "monthly"
  enabled   Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}
