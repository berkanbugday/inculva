{
  "name": "@inculva/widget",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/extract-i18n.mjs",
    "build:cdn": "BUILD_TARGET=cdn vite build && node scripts/extract-i18n.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inculva/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
